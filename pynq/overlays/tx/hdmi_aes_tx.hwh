    <MODULE COREREVISION="34" FULLNAME="/axi_gpio_hdmiin" HWVERSION="2.0" INSTANCE="axi_gpio_hdmiin" IPTYPE="PERIPHERAL" IS_ENABLE="1" MODCLASS="PERIPHERAL" MODTYPE="axi_gpio" VLNV="xilinx.com:ip:axi_gpio:2.0">
